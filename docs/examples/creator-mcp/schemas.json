{
  "authoring": {
    "$defs": {
      "Completeness": {
        "additionalProperties": false,
        "properties": {
          "chapter_notes": {
            "items": {
              "type": "string"
            },
            "title": "Chapter Notes",
            "type": "array"
          },
          "main_subjects": {
            "items": {
              "type": "string"
            },
            "title": "Main Subjects",
            "type": "array"
          },
          "unresolved": {
            "items": {
              "type": "string"
            },
            "title": "Unresolved",
            "type": "array"
          },
          "excluded": {
            "items": {
              "type": "string"
            },
            "title": "Excluded",
            "type": "array"
          }
        },
        "required": [
          "chapter_notes",
          "main_subjects"
        ],
        "title": "Completeness",
        "type": "object"
      },
      "Identity": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subject"
          },
          "character_name": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Character Name"
          },
          "opening": {
            "title": "Opening",
            "type": "string"
          },
          "role": {
            "default": "",
            "maxLength": 180,
            "title": "Role",
            "type": "string"
          },
          "background": {
            "default": "",
            "maxLength": 1200,
            "title": "Background",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "opening"
        ],
        "title": "Identity",
        "type": "object"
      },
      "Media": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "purpose": {
            "const": "cover",
            "default": "cover",
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "title": "Media",
        "type": "object"
      },
      "Opening": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "moment": {
            "title": "Moment",
            "type": "string"
          },
          "chapter": {
            "title": "Chapter",
            "type": "string"
          },
          "location": {
            "maxLength": 180,
            "minLength": 1,
            "title": "Location",
            "type": "string"
          }
        },
        "required": [
          "key",
          "moment",
          "chapter",
          "location"
        ],
        "title": "Opening",
        "type": "object"
      },
      "PlayConfig": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "title": {
            "maxLength": 180,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "introduction": {
            "maxLength": 1200,
            "minLength": 1,
            "title": "Introduction",
            "type": "string"
          },
          "identities": {
            "items": {
              "$ref": "#/$defs/Identity"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Identities",
            "type": "array"
          },
          "openings": {
            "items": {
              "$ref": "#/$defs/Opening"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Openings",
            "type": "array"
          },
          "story_intent": {
            "default": "",
            "maxLength": 6000,
            "title": "Story Intent",
            "type": "string"
          },
          "player_origin": {
            "default": "native",
            "enum": [
              "native",
              "transmigrator"
            ],
            "title": "Player Origin",
            "type": "string"
          },
          "identity_known": {
            "default": true,
            "title": "Identity Known",
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "introduction",
          "identities",
          "openings"
        ],
        "title": "PlayConfig",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "title": {
            "maxLength": 180,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "chapters": {
            "items": {
              "$ref": "#/$defs/SourceChapter"
            },
            "maxItems": 10000,
            "minItems": 1,
            "title": "Chapters",
            "type": "array"
          }
        },
        "required": [
          "key",
          "title",
          "sha256",
          "chapters"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourceChapter": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "index": {
            "minimum": 1,
            "title": "Index",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "line_count": {
            "minimum": 1,
            "title": "Line Count",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "index",
          "sha256",
          "line_count"
        ],
        "title": "SourceChapter",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
        "title": "Version",
        "type": "integer"
      },
      "sources": {
        "items": {
          "$ref": "#/$defs/Source"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Sources",
        "type": "array"
      },
      "scope": {
        "items": {
          "type": "string"
        },
        "maxItems": 10000,
        "minItems": 1,
        "title": "Scope",
        "type": "array"
      },
      "play": {
        "$ref": "#/$defs/PlayConfig"
      },
      "media": {
        "items": {
          "$ref": "#/$defs/Media"
        },
        "maxItems": 1,
        "title": "Media",
        "type": "array"
      },
      "completeness": {
        "$ref": "#/$defs/Completeness"
      }
    },
    "required": [
      "version",
      "sources",
      "scope",
      "play",
      "completeness"
    ],
    "title": "AuthoringPackage",
    "type": "object"
  },
  "guide_world": {
    "$defs": {
