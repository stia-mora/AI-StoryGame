# Copy to a private .env / systemd EnvironmentFile; never commit the filled file.
RPG_DEPLOYMENT_MODE=server
RPG_REQUIRE_AUTH=1
RPG_ENV=prod
RPG_SKIP_AUTO_MIGRATE=1
DATABASE_URL=postgresql://rpg:CHANGE_ME@127.0.0.1:6432/rpg
# Migrations and postproc LISTEN/NOTIFY must use a direct PostgreSQL connection.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
# Generate each independently: openssl rand -hex 32. Preserve across workers/restarts.
RPG_MASTER_KEY=
EMAIL_CODE_SECRET=
RPG_SETUP_TOKEN=
PUBLIC_BASE_URL=https://your-production-domain.com
RPG_CORS_ORIGINS=https://your-production-domain.com
RESEND_API_KEY=
RESEND_FROM=RPG <noreply@your-production-domain.com>
RPG_DATA_ROOT=/var/lib/rpg/platform_data
RPG_TRUSTED_PROXIES=127.0.0.1,::1
RPG_COOKIE_SECURE=1
RPG_COOKIE_SAMESITE=lax
RPG_WORKERS=4
RPG_RATE_LIMIT_PER_MIN=600
RPG_REQUEST_TIMEOUT_SECS=30
RPG_BODY_LIMIT_BYTES=2097152
RPG_UPLOAD_BODY_LIMIT_BYTES=52428800
RPG_POSTPROC_MODE=async
ANTHROPIC_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-004
EMBED_API_KEY=
